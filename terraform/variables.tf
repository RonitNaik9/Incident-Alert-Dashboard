
variable "aws_region" {
  description = "AWS region to deploy into"
  type        = string
  default     = "us-east-1"
}

variable "project_name" {
  description = "Prefix for all resource names"
  type        = string
  default     = "incident-dash"
}

variable "vpc_cidr" {
  description = "CIDR block for the VPC"
  type        = string
  default     = "10.0.0.0/16"
}

variable "simulator_interval" {
  description = "How often the simulator fires (CloudWatch rate expression)"
  type        = string
  default     = "rate(2 minutes)"
}